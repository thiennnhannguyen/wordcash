# Các file/thư mục không đưa lên Git.

# Bí mật và cấu hình máy (không bao giờ commit)
.env
.env.*
!.env.example
# Cấu hình công khai của Vite (chỉ biến VITE_*, không bao giờ chứa bí mật)
!frontend/.env.development
!frontend/.env.production
*.pem
*.key
*.p12
*.pfx
*.crt
id_rsa*
id_ed25519*
secrets/
*.secret
service-account*.json

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
*.db

# Node / build
node_modules/
dist/

# Dữ liệu thô của kho từ
backend/data_pipeline/raw/*
!backend/data_pipeline/raw/.gitkeep

# Hệ điều hành, editor
.DS_Store
.vscode/
.idea/
