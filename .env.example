# Mẫu cấu hình (sao chép thành .env ở gốc repo). Đọc bởi backend/app/core/config.py (pydantic-settings).
ENV=development
PORT=8000

# Database & Redis (driver async: postgresql+asyncpg; URL dạng postgres:// cũng được tự đổi sang asyncpg)
DATABASE_URL=postgresql+asyncpg://wordclash:wordclash_password@localhost:5433/wordclash_db
TEST_DATABASE_URL=postgresql+asyncpg://wordclash:wordclash_password@localhost:5433/wordclash_test
REDIS_URL=redis://localhost:6379/0

# Token: access JWT 15 phút (header Authorization: Bearer), refresh 30 ngày (cookie httpOnly)
# Khi ENV=production, JWT_SECRET_KEY bắt buộc dài ít nhất 32 ký tự.
JWT_SECRET_KEY=dev-jwt-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Cookie refresh token. COOKIE_SECURE để trống: tự bật khi ENV=production.
COOKIE_NAME=wc_refresh
COOKIE_SECURE=
COOKIE_DOMAIN=
COOKIE_PATH=/api/v1/auth

# Chống dò mật khẩu, giới hạn phiên
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=900
REGISTER_MAX_PER_HOUR=10
MAX_SESSIONS_PER_USER=10
DEFAULT_TIMEZONE=Asia/Ho_Chi_Minh
# Chỉ bật khi chạy sau reverse proxy tin cậy (đọc IP từ X-Forwarded-For)
TRUST_PROXY=false

# Socket.IO đồng bộ qua Redis (bật khi chạy nhiều worker)
SIO_USE_REDIS=false

# Client CORS (cũng là Origin duy nhất được gọi /auth/refresh, /auth/logout từ trình duyệt)
FRONTEND_URL=http://localhost:5173

# Audio / dịch vụ ngoài
TTS_API_KEY=

# Hằng số luật game: đã có giá trị mặc định trong config.py, chỉ ghi đè khi cần
# DAILY_FORGET_PENALTY=1
# UNIT_PASS_RATE=0.8
# BOSS_PASS_RATE=0.85
# RANK_GRACE_DAYS=3
# SPIN_EVERY_N_WORDS=50
# PITY_EPIC=20
# MATCH_HP=100
# MATCH_QUESTIONS=20
# DMG_BASE=10
# DMG_FAST_BONUS=5
# FAST_MS=2000
# COMBO_MULT=1.5
# WRONG_SELF_DMG=5
