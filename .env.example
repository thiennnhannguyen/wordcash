# Mẫu cấu hình (sao chép thành .env ở gốc repo). Đọc bởi backend/app/core/config.py (pydantic-settings).
APP_ENV=development
PORT=8000

# Database & Redis (driver async: postgresql+asyncpg; URL dạng postgres:// cũng được tự đổi sang asyncpg)
DATABASE_URL=postgresql+asyncpg://wordclash:wordclash_password@localhost:5432/wordclash_db
TEST_DATABASE_URL=sqlite+aiosqlite://
# Chạy test trên PostgreSQL: TEST_DATABASE_URL=postgresql+asyncpg://wordclash:wordclash_password@localhost:5432/wordclash_test
REDIS_URL=redis://localhost:6379/0

# Bảo mật
JWT_SECRET_KEY=dev-jwt-secret-key-change-in-production
JWT_EXPIRE_MINUTES=10080

# Client CORS
FRONTEND_URL=http://localhost:5173

# Audio / dịch vụ ngoài
TTS_API_KEY=

# Hằng số luật game: đã có giá trị mặc định trong config.py, chỉ ghi đè khi cần
# DAILY_FORGET_PENALTY=1
# UNIT_PASS_RATE=0.8
# BOSS_PASS_RATE=0.85
# RANK_GRACE_DAYS=3
# SPIN_EVERY_N_WORDS=50
# PITY_EPIC=20
# MATCH_HP=100
# MATCH_QUESTIONS=20
# DMG_BASE=10
# DMG_FAST_BONUS=5
# FAST_MS=2000
# COMBO_MULT=1.5
# WRONG_SELF_DMG=5
